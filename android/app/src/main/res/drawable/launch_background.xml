<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<!-- Umbra is OLED-true black (#000000), not the template's default white:
     this is what's visible for the brief window before Flutter's engine
     draws its first frame, and a white flash here undercuts the whole
     dark-first first impression. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />

